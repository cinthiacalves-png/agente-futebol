import os
import smtplib
from email.message import EmailMessage
from google import genai
from google.genai import types

# 1. Configurar o cliente da API do Gemini
client = genai.Client(api_key=os.environ.get("GEMINI_API_KEY"))

# 2. Definir o prompt completo com foco no Futebol Brasileiro e Internacional
prompt = """
Você é um jornalista esportivo e analista sênior especialista em futebol brasileiro e internacional.
Faça uma pesquisa detalhada sobre os acontecimentos das últimas 24 horas no futebol e redija uma newsletter completa e atraente para e-mail.

Divida o e-mail obrigatoriamente nos seguintes tópicos bem estruturados:

1. 🇧🇷 **Destaques do Futebol Brasileiro**:
   - Notícias do momento, bastidores, polêmicas e declarações marcantes no Brasil.
   - Resultados recentes e próximas partidas (Brasileirão, Copa do Brasil, Libertadores, Sul-Americana e Seleção Brasileira).

2. 🏆 **Giro pelo Futebol Internacional**:
   - Principais resultados, momentos marcantes e próximos jogos das grandes ligas europeias (Champions League, Premier League, LaLiga, Serie A, etc.) e torneios globais.

3. 🔁 **Mercado da Bola & Transferências**:
   - Rumores quentes, negociações em andamento e contratações oficializadas (no Brasil e no exterior).

4. ⭐ **Craques & Personagens**:
   - Destaques individuais sobre jogadores brasileiros no exterior, estrelas do futebol e treinadores.

5. 📊 **Análises, Tática e Bastidores**:
   - Resumo das principais discussões da imprensa esportiva, decisões polêmicas de arbitragem/VAR e movimentações de bastidores.

Diretrizes de formatação:
- Responda em HTML limpo e bem formatado (utilize tags <h2>, <h3>, <ul>, <li>, <strong>, <p>, etc.) para garantir uma leitura agradável no e-mail.
- Use um tom de conversa dinâmico, ágil e empolgante.
- Se não houver fatos marcantes em algum ponto nas últimas 24h, foque nos assuntos de maior repercussão no dia.
"""

# 3. Gerar conteúdo usando o Gemini com Google Search Grounding ativo
response = client.models.generate_content(
    model="gemini-2.5-flash",
    contents=prompt,
    config=types.GenerateContentConfig(
        tools=[{"google_search": {}}],  # Busca na web em tempo real
    ),
)

html_content = response.text

# 4. Criar e formatar a mensagem de e-mail (HTML)
msg = EmailMessage()
msg["Subject"] = "⚽ Giro do Futebol: Notícias do Brasil, Europa e Mercado da Bola"
msg["From"] = os.environ.get("EMAIL_USER")
msg["To"] = os.environ.get("EMAIL_TO")

# Define o conteúdo do e-mail como HTML
msg.add_alternative(html_content, subtype="html")

# 5. Enviar via SMTP do Gmail
with smtplib.SMTP_SSL("smtp.gmail.com", 465) as smtp:
    smtp.login(os.environ.get("EMAIL_USER"), os.environ.get("EMAIL_APP_PASSWORD"))
    smtp.send_message(msg)

print("E-mail enviado com sucesso!")
